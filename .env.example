API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGINS=http://localhost:5173
DB_PATH=./data/export-client.sqlite
RFQ_LIMIT_PER_15M=10
TRACK_LOOKUP_LIMIT_PER_15M=60
# Keep at 0 unless the exact number of trusted reverse proxies is known.
TRUST_PROXY_HOPS=0

# Peer synchronization is disabled until a secret is explicitly configured.
# Use a unique node ID in the peer cluster; generate a shared 32+ character secret.
SYNC_NODE_ID=web-local
SYNC_SHARED_SECRET=
# Example local-development peers; align IDs/ports with the mobile and desktop .env.api files.
SYNC_PEERS=mobile-local=http://127.0.0.1:4001,desktop-local=http://127.0.0.1:4002
\n# Supabase Auth (backend). Admin IDs are verified provider user IDs, not emails.\nSUPABASE_URL=\nSUPABASE_ANON_KEY=\nADMIN_USER_IDS=\n\n# Vite client build variables are public identifiers only; never place service-role keys here.\n# VITE_SUPABASE_URL=\n# VITE_SUPABASE_ANON_KEY=\n